#!/bin/bash

# =================================================================
# 🚀 bin/aic v3.3 - AI-Driven Commit Assistant (Resilient Edition)
# Optimized for Conventional Commits with Smart Model Fallback
# =================================================================

# 0. 環境変数のセットアップ
DOTPATH="${DOTPATH:-$(cd "$(dirname "$0")/.." && pwd)}"
[ -f "$DOTPATH/common/.env.local" ] && source "$DOTPATH/common/.env.local"

# PATHに ~/.local/bin を含める (非対話シェルでも安全に動作)
export PATH="$HOME/.local/bin:$PATH"

_call_llm_model() {
    local model="$1"
    local system_prompt="$2"
    local input_data="$3"
    local timeout_sec="${4:-15}"

    local -a opts=()
    if [[ "$model" =~ gemini-3\.[0-9]-flash ]]; then
        opts=(-o thinking_level low)
    fi

    # timeout コマンドで長時間ハングを防止し、エラーもキャプチャ
    local err_file
    err_file=$(mktemp)
    local output
    output=$(echo -e "$input_data" | timeout "${timeout_sec}s" llm prompt -m "$model" "${opts[@]}" -s "$system_prompt" 2>"$err_file")
    local ret=$?

    local err_msg
    err_msg=$(cat "$err_file")
    rm -f "$err_file"

    if [[ $ret -eq 0 && -n "$output" ]]; then
        echo "$output"
        return 0
    else
        if [[ $ret -eq 124 ]]; then
            echo "Request timed out after ${timeout_sec}s" >&2
        elif [[ -n "$err_msg" ]]; then
            echo "$err_msg" | tail -n 2 >&2
        fi
        return 1
    fi
}

_ai_generate_commit_proposals() {
    if [[ -z "$GEMINI_API_KEY" ]]; then
        if ! llm keys list | grep -q "gemini" 2>/dev/null; then
            echo "⚠️  GEMINI_API_KEY is not detected in env or llm keys." >&2
            echo "    Please set it via 'export GEMINI_API_KEY=...' or 'llm keys set gemini'" >&2
            return 1
        fi
    fi

    # 1. Diff の統計情報と中身を取得
    local diff_stat
    diff_stat=$(git diff --cached --stat)
    local full_diff
    full_diff=$(git diff --cached | head -c 20000)
    local input_data="Context - File Statistics:\n$diff_stat\n\nActual Diff:\n$full_diff"

    # 2. システムプロンプト (Conventional Commits 準拠)
    local system_prompt="You are a world-class software engineer. 
Analyze the provided git diff and generate EXACTLY 3 high-quality commit message proposals in English.

Requirements:
1. Follow Conventional Commits (e.g., feat:, fix:, refactor:, chore:, docs:, ci:).
2. Use the imperative mood (e.g., 'Add' instead of 'Added').
3. Subject line must be under 50 characters.
4. If the change is complex, focus on the primary 'Why' and 'What'.
5. Output EXACTLY 3 lines. One proposal per line.
6. NO markdown, NO numbers, NO bullet points, NO extra text. 

Example Output:
feat(auth): add OAuth2 provider support
fix(api): resolve memory leak in connection pool
chore(deps): update dependency-xyz to v2.0.0"

    # 3. 試行するモデルのリスト (プライマリ -> フォールバック)
    local primary_model="${AI_ASSIST_MODEL:-gemini-3.8-flash}"
    local fallback_model="${AI_FALLBACK_MODEL:-gemini-2.5-flash}"

    # プライマリモデルで試行
    echo "🤖 AI is analyzing changes ($primary_model)..." >&2
    local err_file
    err_file=$(mktemp)
    local out_file
    out_file=$(mktemp)

    _call_llm_model "$primary_model" "$system_prompt" "$input_data" 12 >"$out_file" 2>"$err_file"
    local ret=$?

    if [[ $ret -eq 0 && -s "$out_file" ]]; then
        cat "$out_file"
        rm -f "$out_file" "$err_file"
        echo "$primary_model" > /tmp/aic_used_model.$$
        return 0
    fi

    local err_msg
    err_msg=$(cat "$err_file")
    rm -f "$out_file" "$err_file"

    # プライマリ失敗時: フォールバックモデルで再試行
    echo "⚠️  $primary_model unavailable (${err_msg:-busy/timeout})." >&2
    echo "🔄 Falling back to $fallback_model..." >&2

    err_file=$(mktemp)
    out_file=$(mktemp)

    _call_llm_model "$fallback_model" "$system_prompt" "$input_data" 15 >"$out_file" 2>"$err_file"
    ret=$?

    if [[ $ret -eq 0 && -s "$out_file" ]]; then
        cat "$out_file"
        rm -f "$out_file" "$err_file"
        echo "$fallback_model" > /tmp/aic_used_model.$$
        return 0
    fi

    err_msg=$(cat "$err_file")
    rm -f "$out_file" "$err_file"

    echo "❌ All AI models failed. Reason: ${err_msg:-unknown error}" >&2
    return 1
}

main() {
    # ステージング確認
    if git diff --cached --quiet; then
        echo "❌ No changes staged. (Use 'git add' first)"
        return 1
    fi

    # ツールチェック
    if ! command -v fzf &>/dev/null || ! command -v llm &>/dev/null; then
        echo "❌ Required tools (fzf, llm) not found."
        return 1
    fi

    rm -f /tmp/aic_used_model.$$
    local proposals
    proposals=$(_ai_generate_commit_proposals)

    if [[ -z "$proposals" ]]; then
        rm -f /tmp/aic_used_model.$$
        return 1
    fi

    local model_name="AI"
    if [[ -f /tmp/aic_used_model.$$ ]]; then
        model_name=$(cat /tmp/aic_used_model.$$)
        rm -f /tmp/aic_used_model.$$
    fi

    # 選択肢の構築
    local choices
    choices=$(echo -e "${proposals}\n---\n[Manual Input]")

    # fzf で選択 (右側に diff プレビューを表示)
    local selected
    selected=$(echo "$choices" | grep -v '^$' | fzf \
        --height 60% --reverse --border --ansi \
        --header "Select $model_name Proposal (ESC to cancel)" \
        --preview "git diff --cached --color=always" \
        --preview-window "right:60%:wrap")

    # キャンセル処理
    if [[ -z "$selected" || "$selected" == "---" ]]; then
        echo "Aborted."
        return 0
    fi

    # 手入力モード
    if [[ "$selected" == "[Manual Input]" ]]; then
        echo -n "✍️  Enter message: "
        read -r selected
    fi

    # コミット実行
    if [[ -n "$selected" ]]; then
        _execute_commit "$selected" "$model_name"
    fi
}

_execute_commit() {
    local message="$1"
    local model="$2"
    git commit -m "$message"

    # クリップボードコピー
    if command -v pbcopy &>/dev/null; then
        echo -n "$message" | pbcopy
        echo "📋 Message copied to clipboard."
    elif command -v xclip &>/dev/null; then
        echo -n "$message" | xclip -selection clipboard
        echo "📋 Message copied to clipboard."
    fi
    echo "✨ Committed successfully with $model!"
}

main "$@"
