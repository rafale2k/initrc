#!/bin/bash
# =================================================================
# ginv - Gemini / LLM Direct Invocation CLI
# Default: gemini-3.8-flash (thinking_level: low)
# =================================================================

MODEL="${AI_ASSIST_MODEL:-gemini-3.8-flash}"
OPTS=()
if [[ "$MODEL" =~ gemini-3\.[0-9]-flash ]]; then
    OPTS=(-o thinking_level low)
fi

# 入力の取得 (引数優先、なければ標準入力)
if [ -n "$1" ]; then
    INPUT="$*"
elif [ ! -t 0 ]; then
    INPUT=$(cat)
else
    echo "Usage: ginv 'prompt' or command | ginv" >&2
    exit 1
fi

[ -z "$INPUT" ] && exit 1

llm "$INPUT" -m "$MODEL" "${OPTS[@]}" --no-stream

