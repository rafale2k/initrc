#!/bin/bash
set -euo pipefail

# 0. 環境変数のセットアップ
DOTPATH="${DOTPATH:-$(cd "$(dirname "$0")/.." && pwd)}"
[ -f "$DOTPATH/common/.env.local" ] && source "$DOTPATH/common/.env.local"
export PATH="/home/y/.local/bin:$HOME/.local/bin:/usr/local/bin:$PATH"
if [ -z "${LLM_USER_PATH:-}" ] && [ -d "/home/y/.config/io.datasette.llm" ]; then
    export LLM_USER_PATH="/home/y/.config/io.datasette.llm"
fi

# 1. バージョン情報の取得と更新
CURRENT_VERSION=$(cat VERSION)
echo "Current version: $CURRENT_VERSION"
read -p "Enter new version (Press Enter to auto-bump): " NEW_VERSION

# 自動インクリメント
if [ -z "$NEW_VERSION" ]; then
    NEW_VERSION=$(echo "$CURRENT_VERSION" | awk -F. '{$NF = $NF + 1;} 1' OFS=.)
fi

# 以降で使用する変数を統一
VERSION="v$NEW_VERSION"      # タグ用 (v1.33.2)
DOCK_VER="$NEW_VERSION"      # Docker/ファイル書き込み用 (1.33.2)
DOCKER_REPO="rafale2k/initrc"

echo "🚀 Preparing Release $VERSION..."

# 2. ファイルの更新
echo "$DOCK_VER" > VERSION
# READMEのバッジを更新（正規表現をルーズにして確実に置換）
sed -i "s/version-.*-blue/version-v${DOCK_VER}-blue/g" README.md

# 3. 前回のタグからの差分を最新10件に絞って取得
PREV_TAG=$(git describe --tags --abbrev=0 2>/dev/null)

GIT_RANGE=()
if [ -n "$PREV_TAG" ]; then
    GIT_RANGE=("${PREV_TAG}..HEAD")
fi

CHANGELOG=$(git log "${GIT_RANGE[@]}" --oneline -n 10)
DIFF_DATA=$(git log "${GIT_RANGE[@]}" --oneline --stat -n 10)

# Gemini用の作業ファイル作成
echo "Current Changes:" > Update.md
echo "$CHANGELOG" >> Update.md

# 4. Lint Check
echo "🔍 Running lint..."
find . -type f -name "*.sh" \
    -not -path "*/.git/*" \
    -not -path "*/oh-my-zsh/*" \
    -not -path "*/plugins/*" \
    -not -path "*/themes/*" \
    -not -path "*/templates/*" \
    | xargs shellcheck --severity=error

_call_llm_model() {
    local model="$1"
    local system_prompt="$2"
    local input_data="$3"
    local timeout_sec="${4:-15}"

    local -a opts=()
    if [[ "$model" =~ gemini-3\.[0-9]-flash ]]; then
        opts=(-o thinking_level low)
    fi

    local err_file
    err_file=$(mktemp)
    local output
    if output=$(echo -e "$input_data" | timeout "${timeout_sec}s" llm prompt -m "$model" "${opts[@]}" -s "$system_prompt" 2>"$err_file") && [[ -n "$output" ]]; then
        echo "$output"
        rm -f "$err_file"
        return 0
    else
        local ret=$?
        local err_msg
        err_msg=$(cat "$err_file" 2>/dev/null || true)
        rm -f "$err_file"
        if [[ $ret -eq 124 ]]; then
            echo "Request timed out after ${timeout_sec}s" >&2
        elif [[ -n "$err_msg" ]]; then
            echo "$err_msg" | tail -n 2 >&2
        fi
        return 1
    fi
}

_generate_ai_summary() {
    local input_data="$1"
    local system_prompt="SREとして、今回の変更を3行で情熱的に日本語で要約して。各行に絵文字を付けて。"

    local primary_model="${AI_ASSIST_MODEL:-gemini-3.8-flash}"
    local fallback_model="${AI_FALLBACK_MODEL:-gemini-2.5-flash}"

    # プライマリモデルで試行
    echo "🤖 Generating AI summary ($primary_model)..." >&2
    local err_file out_file
    err_file=$(mktemp)
    out_file=$(mktemp)

    if _call_llm_model "$primary_model" "$system_prompt" "$input_data" 12 >"$out_file" 2>"$err_file" && [[ -s "$out_file" ]]; then
        cat "$out_file"
        rm -f "$out_file" "$err_file"
        return 0
    fi

    local err_msg
    err_msg=$(cat "$err_file" 2>/dev/null || true)
    rm -f "$out_file" "$err_file"

    # プライマリ失敗時: フォールバックモデルで再試行
    echo "⚠️  $primary_model unavailable (${err_msg:-busy/timeout})." >&2
    echo "🔄 Falling back to $fallback_model..." >&2

    err_file=$(mktemp)
    out_file=$(mktemp)

    if _call_llm_model "$fallback_model" "$system_prompt" "$input_data" 15 >"$out_file" 2>"$err_file" && [[ -s "$out_file" ]]; then
        cat "$out_file"
        rm -f "$out_file" "$err_file"
        return 0
    fi

    err_msg=$(cat "$err_file" 2>/dev/null || true)
    rm -f "$out_file" "$err_file"

    echo "⚠️  All AI models failed (${err_msg:-unknown error}). Proceeding without AI summary." >&2
    return 1
}

# 5. AI Summary
AI_SUMMARY=$(_generate_ai_summary "$DIFF_DATA" || true)

# 6. CHANGELOG.md 更新
~/dotfiles/bin/gen-changelog "$VERSION"

if [ -n "$AI_SUMMARY" ]; then
    TEMP_FILE=$(mktemp)
    # 修正ポイント：awk内の改行とクォートを安全な形式に変更
    awk -v summary="> ### 🤖 AI Release Summary\n> $AI_SUMMARY\n\n---" '
    BEGIN { done = 0 }
    /## \[/ && done == 0 { print; print "\n" summary; done = 1; next }
    { print }' CHANGELOG.md > "$TEMP_FILE" && mv "$TEMP_FILE" CHANGELOG.md
fi

# 7. README.md への最新ノート同期
echo "🐳 Syncing to README.md..."
LATEST_NOTES=$(awk '/^## \[/ { count++; if (count > 1) exit; } { if (count == 1) print }' CHANGELOG.md)

# マーカーの定義（一文字ずつ打ち込んだ通り）
START_MARKER="<!-- RELEASE_NOTES_START -->"
END_MARKER="<!-- RELEASE_NOTES_END -->"

# LATEST_NOTES が空（バージョン行以外に中身がない）場合はスキップ
if [ -z "$(echo "$LATEST_NOTES" | grep -v '^## \[')" ]; then
    echo "⚠️  Skip: No new release notes found. Keeping current README."
else
    # 画像パスを GitHub の絶対 URL に置換
    LATEST_NOTES=$(echo "$LATEST_NOTES" | sed "s|\./assets/|https://raw.githubusercontent.com/rafale2k/initrc/main/assets/|g")

    if [ -f README.md ] && grep -q "$START_MARKER" README.md; then
        TMP_README=$(mktemp)
        sed -n "1,/$START_MARKER/p" README.md > "$TMP_README"
        echo -e "\n$LATEST_NOTES\n" >> "$TMP_README"
        sed -n "/$END_MARKER/,\$p" README.md >> "$TMP_README"
        mv "$TMP_README" README.md
        echo "✅ README.md updated."
    else
        echo "⚠️  Skip: README.md marker not found."
    fi
fi

# 8. Git Commit & Tag
git add CHANGELOG.md README.md VERSION
if ! git diff --staged --quiet; then
    git commit -m "chore: release $VERSION"
fi
git tag -af "$VERSION" -m "Release $VERSION"

# 9. Docker Build & Push
echo "🐳 Building Docker image..."
DOCKER_BUILDKIT=1 docker build -t "$DOCKER_REPO:$DOCK_VER" .
docker tag "$DOCKER_REPO:$DOCK_VER" "$DOCKER_REPO:latest"
docker push "$DOCKER_REPO:$DOCK_VER" &
docker push "$DOCKER_REPO:latest" &
wait

# 10. Final Push（強制プッシュで Actions との歴史のズレを解消）
git push origin main --force --tags

# 11. 掃除
rm -f Update.md

echo "✨ Successfully released $VERSION!"
